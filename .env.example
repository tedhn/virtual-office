# Stream credentials, from https://dashboard.getstream.io -> your app.
#
# Dev and prod use SEPARATE Stream apps so local testing never touches production
# usage or data. Copy this file to:
#
#   .dev    dev app keys   — used by `npm run dev`
#   .prod   prod app keys  — used by `npm start`
#
# NODE_ENV selects which one (set by the npm scripts). A `.env` is still read last as
# a shared fallback, and real environment variables beat every file — so on Railway you
# set these in the dashboard and no file is needed at all.
#
# .dev, .prod and .env are all gitignored. Only this example is tracked. Never commit
# a real STREAM_API_SECRET; if one leaks, rotate it in the Stream dashboard.

# Server-side (token minting). NEVER expose the secret to the browser.
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Optional: token server port (defaults to 3001). Do NOT set this in a hosted
# environment — platforms inject their own PORT, and binding the wrong one makes the
# service unreachable.
PORT=3001

# NOTE on browser-side vars: .dev and .prod are read by the token server only. Vite
# auto-loads `.env[.mode]` files exclusively, so a VITE_* var placed in .dev/.prod will
# NOT reach the browser bundle. It doesn't need to — the browser receives the Stream API
# key from /api/token at runtime, so it always uses the key of whichever environment
# served it (src/lib/stream.ts). Put VITE_* vars in .env if you ever need them at build
# time; note they are baked into the bundle, so public values only.

# Optional: only when the token server is hosted on a DIFFERENT origin than the
# frontend (split deploy). Belongs in .env, not .dev/.prod — see the note above. Leave
# unset for the Vite dev proxy or for single-service production, where /api is
# same-origin either way.
# VITE_API_URL=https://api.your-domain.com

# ---------------------------------------------------------------------------------
# Supabase — identity and the offices table.
#
# A Visitor is signed in anonymously the moment the page loads; creating an Office needs
# a magic-link account (ADR-0003). Anonymous sign-ins must be enabled for the project or
# that silent sign-in fails. supabase/config.toml already sets it; `npm run config:push`
# applies it to the linked project (or toggle it under Authentication -> Sign In /
# Providers -> Anonymous sign-ins).
#
# These are browser-side, so they belong in `.env` (Vite only reads `.env[.mode]`, never
# .dev/.prod — see the note above) and they must carry the `VITE_` prefix: that prefix is
# what Vite exposes to the bundle, so a key pasted from the dashboard's Next.js snippet
# as NEXT_PUBLIC_… never reaches the app.
#
# The publishable key (`sb_publishable_…`) is what Supabase used to call the anon key;
# either name works here. It is public by design — row-level security is what protects
# the data, not the key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Database suites only (supabase/tests/). Without this key they skip entirely. The
# secret key (`sb_secret_…`) is what Supabase used to call the service role key;
# SUPABASE_SERVICE_ROLE_KEY is still read under its old name.
#
# Two warnings, both real. This key BYPASSES row-level security, so it must never reach
# the browser bundle or a repo — this file is the example, `.env` is gitignored, keep it
# that way. And the suites create and delete throwaway accounts in whatever project they
# are pointed at, so aiming them at a project with real users in it means test accounts
# appearing and disappearing among them.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# The database suites read the VITE_ pair above by default. Set these to send them
# somewhere else — a scratch project while the browser talks to the main one, say.
# SUPABASE_URL=https://your-scratch-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_scratch_publishable_key
